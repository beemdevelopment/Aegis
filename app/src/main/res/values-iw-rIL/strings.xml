    <string name="invalidated_biometrics">זוהו שינויים בהגדרות האבטחה של מכשירך. נא לעבור אל „Aegis -&gt; הגדרות -&gt; אבטחה -&gt; נעילה ביומטרית\" בשביל להשבית ולהפעיל מחדש את הנעילה הביומטרית.</string>
    <string name="password_reminder">נא להקליד את הסיסמה שלך. אנחנו מבקשים זאת מדי פעם כדי שהסיסמה שלך לא תישכח.</string>
    <string name="password_reminder_dialog_title">פתיחה באמצעות זיהוי ביומטרי כברירת מחדל</string>
    <string name="password_reminder_dialog_message">מדי פעם אנחנו מבקשים להקליד את הסיסמה שלך במקום זאת בשביל למנוע ממך לשכוח אותה ולהינעל מחוץ לכספת. לאחר הקלדת הסיסמה, Aegis יחזור להשתמש בפתיחה באמצעות זיהוי ביומטרי כברירת מחדל עד שיגיע הזמן להיזכר שוב בסיסמה.</string>
